# Copy to .env for local development: `copy .env.example .env` (Windows).
# Every key and value is documented in docs/09-server-config.md. Never commit .env.

# ── Server (apps/server) — required ─────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://royalnavy:royalnavy@localhost:5432/royalnavy
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-only-change-me-access
JWT_REFRESH_SECRET=dev-only-change-me-refresh

# ── Server — optional (defaults shown) ──────────────────────────────────────
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
ROOM_CODE_ALPHABET=ABCDEFGHJKLMNPQRSTUVWXYZ23456789
MATCH_STATE_TTL=86400
RECONNECT_GRACE_SECONDS=90
MAX_PUBLISHED_BOARDS=3
PROFANITY_LIST_PATH=./config/blocklist.txt
TRADEMARK_LIST_PATH=./config/trademarks.txt
LOG_LEVEL=info
LOG_PRETTY=true
METRICS_ENABLED=true
CORS_ORIGINS=*

# ── Mobile (apps/mobile) — only EXPO_PUBLIC_* reaches the bundle ────────────
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:3000
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_SENTRY_DSN=
