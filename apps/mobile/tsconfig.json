{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-native",
    "types": ["react-native", "jest"],
    // The "@/" alias mirrors Expo's default so imports read `@/screens/...` instead of `../../`.
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  // `expo start` checks that app, src, *.js and *.ts are listed here and rewrites the list if not.
  "include": ["app", "src", "*.js", "*.ts", "*.d.ts"]
}
